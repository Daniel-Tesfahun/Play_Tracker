{
  "expo": {
    "name": "PlayTracker",
    "slug": "playtracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.flotitan.playtracker"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0D16",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.flotitan.playtracker",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-font",
      "expo-asset",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0D16",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160
        }
      ]
    ],
    "scheme": "playtracker",
    "backgroundColor": "#0B0D16",
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "8237993e-e423-4644-aba9-92adbf9ded29"
      }
    },
    "owner": "flo-titan"
  }
}
